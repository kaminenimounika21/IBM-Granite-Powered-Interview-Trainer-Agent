# ==============================================================================
# IBM Cloud & watsonx.ai Credentials Configuration
# Copy this file to .env and insert your IBM Cloud credentials
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# IBM watsonx.ai Foundation Model Access
# Obtain API key from: https://cloud.ibm.com/iam/apikeys
WATSONX_APIKEY=
# Obtain Project ID from your watsonx.ai Project Settings GUID
WATSONX_PROJECT_ID=
# Regional Endpoint: Dallas (us-south), Frankfurt (eu-de), Tokyo (jp-tok)
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Foundation Model: ibm/granite-3-8b-instruct, ibm/granite-13b-chat-v2, ibm/granite-34b-code-instruct
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
# Dense Vector Embedding Model: ibm/slate-30m-english-rtr or ibm/slate-125m-english-rtr
WATSONX_EMBEDDING_MODEL_ID=ibm/slate-30m-english-rtr

# IBM Cloud Object Storage (COS)
IBM_COS_APIKEY=
IBM_COS_SERVICE_INSTANCE_ID=
IBM_COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
IBM_COS_BUCKET_NAME=ibm-interview-resumes-vault

# IBM Cloudant / Persistent Storage (Leave blank for default SQLite storage)
IBM_CLOUDANT_URL=
IBM_CLOUDANT_APIKEY=
